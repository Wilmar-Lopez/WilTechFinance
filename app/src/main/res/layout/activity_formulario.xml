<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NUEVA ACTIVIDAD"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/etConcepto"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="#111111"
        android:hint="Concepto (Ej: Pago Nómina, Almuerzo)"
        android:textColorHint="#555555"
        android:textColor="#FFFFFF"
        android:paddingLeft="15dp"
        android:layout_marginBottom="15dp"
        android:inputType="text"/>

    <EditText
        android:id="@+id/etMonto"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:background="#111111"
        android:hint="Monto de dinero ($)"
        android:textColorHint="#555555"
        android:textColor="#FFFFFF"
        android:paddingLeft="15dp"
        android:layout_marginBottom="25dp"
        android:inputType="numberDecimal"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona el tipo:"
        android:textColor="#8C8C8C"
        android:textSize="16sp"
        android:layout_gravity="start"
        android:layout_marginBottom="10dp"/>

    <RadioGroup
        android:id="@+id/rgTipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="40dp"
        android:gravity="center">

        <RadioButton
            android:id="@+id/rbIngreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INGRESO (+)"
            android:textColor="#FFFFFF"
            android:buttonTint="#00FF00"
            android:layout_marginEnd="30dp"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/rbGasto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GASTO (-)"
            android:textColor="#FFFFFF"
            android:buttonTint="#E50914"/>
    </RadioGroup>

    <Button
        android:id="@+id/btnRegistrarActividad"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="GUARDAR MOVIMIENTO"
        android:backgroundTint="#E50914"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/btnCancelarActividad"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="CANCELAR"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF"/>

</LinearLayout>