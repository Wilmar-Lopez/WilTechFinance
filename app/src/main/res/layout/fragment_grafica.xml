<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PANEL DE GRÁFICAS"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="25dp"/>

        <LinearLayout
            android:id="@+id/btnVerGraficaDiaria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111111"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📈 ANALIZAR GRÁFICA DIARIA"
                android:textColor="#E50914"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGastoMasAlto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gasto más alto de hoy: $0,00"
                android:textColor="#8C8C8C"
                android:textSize="13sp"
                android:layout_marginTop="5dp"/>
        </LinearLayout>

        <com.example.wiltechfinance.PlanoCartesianoView
            android:id="@+id/planoCartesianoDiario"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#111111"
            android:layout_marginBottom="25dp"/>


        <LinearLayout
            android:id="@+id/btnVerGraficaSemanal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#111111"
            android:orientation="vertical"
            android:padding="20dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊 ANALIZAR GRÁFICA SEMANAL"
                android:textColor="#E50914"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMontoMasAltoSemanal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monto más alto de la semana: $0,00"
                android:textColor="#8C8C8C"
                android:textSize="13sp"
                android:layout_marginTop="5dp"/>
        </LinearLayout>

        <com.example.wiltechfinance.PlanoCartesianoView
            android:id="@+id/planoCartesianoSemanal"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#111111"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>