<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="15dp">

        <androidx.cardview.widget.CardView
            android:layout_width="45dp"
            android:layout_height="45dp"
            app:cardCornerRadius="22.5dp"
            app:cardBackgroundColor="#333333"
            android:layout_marginRight="12dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@android:drawable/ic_menu_myplaces"
                android:padding="8dp"
                app:tint="#FFFFFF"
                android:contentDescription="Icono Usuario"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvNombreUsuario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hola, Prueba"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCerrarSesionTop"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:src="@android:drawable/ic_lock_power_off"
            app:tint="#E50914"
            android:contentDescription="Salir"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contenedorHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutHeader"
        android:layout_above="@id/barraNavegacionInferior"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <LinearLayout
        android:id="@+id/layoutSaldo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_centerInParent="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monto disponible:"
            android:textColor="#8C8C8C"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvMontoTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$1,500,000.00"
            android:textColor="#FFFFFF"
            android:textSize="42sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/btnEditarPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EDITAR PERFIL"
            android:textSize="12sp"
            android:backgroundTint="#222222"
            android:textColor="#FFFFFF"
            android:layout_marginTop="15dp" />

        <Button
            android:id="@+id/btnActividad"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="NUEVA ACTIVIDAD (INGRESO/GASTO)"
            android:backgroundTint="#E50914"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="40dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/barraNavegacionInferior"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:background="#111111"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/menuHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HOME"
            android:backgroundTint="#000000"
            android:textColor="#E50914"
            android:textSize="12sp" />

        <Button
            android:id="@+id/menuHistorial"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HISTORIAL"
            android:backgroundTint="#000000"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/menuGrafica"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GRÁFICA"
            android:backgroundTint="#000000"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</RelativeLayout>