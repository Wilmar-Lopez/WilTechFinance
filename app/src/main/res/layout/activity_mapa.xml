<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Barra Superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#141414"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnVolverMapa"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:backgroundTint="#333333"
            android:text="←"
            android:textSize="18sp"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="MAPA DE GASTOS"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Contenedor del Mapa con elementos superpuestos -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <fragment
            android:id="@+id/mapaFragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Barra de carga mientras localiza el GPS -->
        <ProgressBar
            android:id="@+id/pbCargandoMapa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#E50914"
            android:visibility="visible" />

        <!-- Botón flotante para centrar la ubicación actual -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMiUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:contentDescription="Mi ubicación"
            app:backgroundTint="#E50914"
            app:tint="#FFFFFF"
            app:srcCompat="@android:drawable/ic_menu_mylocation" />
    </FrameLayout>

</LinearLayout>